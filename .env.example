DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-long-random-secret"

# Public deployment can keep AI disabled until a cloud LLM provider is connected.
# Available values: disabled, ollama, external.
LLM_PROVIDER="disabled"

# Local AI demo, not required for public auth/tasks/focus/analytics.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Optional external LLM provider.
# EXTERNAL_LLM_API_URL can point to a Responses API or /chat/completions endpoint.
EXTERNAL_LLM_API_URL=""
EXTERNAL_LLM_API_KEY=""
EXTERNAL_LLM_MODEL=""
