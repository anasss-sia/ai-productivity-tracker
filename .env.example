DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-long-random-secret"

# Public deployment can keep AI disabled until a cloud LLM provider is connected.
AI_PROVIDER="disabled"

# Local AI demo, not required for public auth/tasks/focus/analytics.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Optional paid/limited cloud AI provider. Leave empty if you use Ollama locally.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
